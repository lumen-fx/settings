<root padding="28" gap="18" bg="#0c1c30">
  <label class="title" height="40px" text="Settings" />
  <column class="group" padding="16" gap="10">
    <label class="group-title" text="Appearance" />
    <row gap="10" align="center">
      <label class="caption" width="120px" text="Theme" />
      <dropdown bind-value="theme">
        <option label="Dark" value="dark" />
        <option label="Light" value="light" />
        <option label="Follow system" value="system" />
      </dropdown>
    </row>
    <column gap="4">
      <label class="caption" text="Density" />
      <radio group="density" label="Compact" value="compact" />
      <radio checked="true" group="density" label="Comfortable" value="comfortable" />
      <radio group="density" label="Spacious" value="spacious" />
    </column>
    <row gap="10" align="center">
      <label class="caption" width="120px" text="UI scale" />
      <slider id="scale" height="28px" grow="1" bind-value="scale" max="1.6" min="0.8" step="0.1" value="1.0" />
      <label class="caption" width="40px" text="1.0" text-align="end" bind-text="scale_label" />
    </row>
  </column>
  <column class="group" padding="16" gap="8">
    <label class="group-title" text="Notifications" />
    <checkbox id="email" bind-checked="notify_email" label="Email digests" />
    <checkbox id="push" bind-checked="notify_push" checked="true" label="Push notifications" />
    <checkbox id="sound" bind-checked="notify_sound" label="Sounds" />
    <row gap="12" align="center">
      <toggle id="dnd" width="48px" height="28px" bind-checked="dnd" />
      <label class="caption" text="Do not disturb" />
    </row>
  </column>
  <label class="summary" height="60px" text="" wrap="word" bind-text="summary" />
  <script src="main.cdl" />
</root>
